# All production Compose builds use the repository root as their context.
# Allow only build inputs; local configuration and secrets stay on the host.
**
!backend/
backend/**
!backend/pyproject.toml
!backend/uv.lock
!backend/alembic.ini
!backend/src/
!backend/src/**
!backend/migrations/
!backend/migrations/**
!config/
config/**
!config/agent.yaml
!config/application.yaml
!config/database.yaml
!config/providers.yaml
!config/rag.yaml
!config/tokenizers.yaml
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!deploy/
deploy/**
!deploy/backend/
deploy/backend/**
!deploy/backend/Dockerfile
!deploy/database-mcp/
deploy/database-mcp/**
!deploy/database-mcp/Dockerfile
!deploy/frontend/
deploy/frontend/**
!deploy/frontend/Dockerfile
!deploy/frontend/nginx.conf
!deploy/frontend/edge-entrypoint.sh
!deploy/office-converter/
deploy/office-converter/**
!deploy/office-converter/Dockerfile

# Keep these last: also protect against sensitive files inside allowed trees.
**/.git/**
**/.local/**
**/.venv/**
**/node_modules/**
**/__pycache__/**
**/*.pyc
**/.env*
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.local.*
**/*.secret.*
**/*.before-*
