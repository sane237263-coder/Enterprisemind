# Local closed test image. This is not a production release artifact.
FROM golang:1.24.8-bookworm@sha256:4ed690d6649d63c312b99a6120025ec79ce3b542968a37da53d6236c7c61a848 AS build
WORKDIR /src
COPY source.tar.gz /tmp/source.tar.gz
RUN echo '45521908307306e925c98d629e1c17d78c8b72b6ee242b1bfb1409f7d8ee5841  /tmp/source.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 -C /src
ENV CGO_ENABLED=0 GOMAXPROCS=2 GOMEMLIMIT=512MiB GOPROXY=https://goproxy.cn
RUN go build -p 1 -trimpath -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a' -o /minio .
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /minio /minio
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/minio"]
CMD ["server", "/data", "--address", ":9000", "--console-address", ":9001", "--quiet"]
