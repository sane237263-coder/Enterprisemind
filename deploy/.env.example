# Copy outside the repository to a release-specific environment file.
# Every image reference must include @sha256:<digest>; floating tags and
# :latest are rejected by deploy/preflight.py.
EM_COMPOSE_PROJECT=enterprise-mind-prod-RELEASE_ID
EM_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_INITIAL_ADMIN
EM_PUBLIC_ORIGIN=https://CHANGE_ME_APPROVED_DOMAIN
EM_PUBLIC_HOST=CHANGE_ME_APPROVED_DOMAIN
EM_EDGE_IP=CHANGE_ME_APPROVED_EDGE_IP
EM_EDGE_BIND=127.0.0.1
EM_HTTP_PORT=80
EM_HTTPS_PORT=443
EM_MINIO_BUCKET=enterprise-mind-production-RELEASE_ID

EM_PYTHON_IMAGE=python:3.13.15-slim-bookworm@sha256:CHANGE_ME
EM_UV_IMAGE=ghcr.io/astral-sh/uv:0.12.15@sha256:CHANGE_ME
EM_NODE_IMAGE=node:24.16.0-bookworm-slim@sha256:CHANGE_ME
EM_NGINX_IMAGE=nginx:1.29.1-alpine@sha256:CHANGE_ME
EM_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18-bookworm@sha256:2ba9ca5f2e7daa0f0e7723cba1ee9167bab54efd3640516a44ac1a928dd67e7a
EM_REDIS_IMAGE=redis:8.10.1-alpine3.23@sha256:becdda6c7f4b3fb42e42fd7f120bbf5c54c4caaaf16f26da24e4563d2c1f0576
EM_MINIO_IMAGE=minio/minio:RELEASE-CHANGE_ME@sha256:CHANGE_ME

# Absolute paths on the approved Linux host.  The files stay outside Git.
EM_SECRET_DIR=/srv/enterprise-mind/releases/RELEASE_ID/secrets
EM_CONFIG_DIR=/srv/enterprise-mind/releases/RELEASE_ID/config
EM_TLS_CERT_FILE=/srv/enterprise-mind/releases/RELEASE_ID/tls/fullchain.pem
EM_TLS_KEY_FILE=/srv/enterprise-mind/releases/RELEASE_ID/tls/privkey.pem
