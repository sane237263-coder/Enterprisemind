# Copy to .env for reference; the application reads process environment, not .env implicitly.
# Set absolute paths to secret files kept outside Git. No example credentials are supplied.
EM_ENV=development
EM_POSTGRES_HOST=127.0.0.1
EM_POSTGRES_PORT=5432
EM_POSTGRES_DATABASE=enterprise_mind
EM_POSTGRES_USER=enterprise_mind_app
EM_POSTGRES_PASSWORD_FILE=
EM_TOKEN_SIGNING_KEY_FILE=
EM_APPLICATION_CONFIG=config/application.yaml
# First provision-database uses the initialization superuser, then switch credentials:
# migrate: enterprise_mind_migrator; serve: enterprise_mind_app.
# provision-database takes --migrator-password-file, --app-password-file, --backup-password-file.
# Required only for the first empty-system initialization, then remove both bootstrap variables.
EM_BOOTSTRAP_ADMIN_USERNAME=
EM_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# Required in production:
EM_PUBLIC_ORIGIN=
# API, dispatcher and worker use the application identities, never MinIO root.
EM_MINIO_ENDPOINT=127.0.0.1:9000
EM_MINIO_BUCKET=enterprise-mind
EM_MINIO_SECURE=false
EM_MINIO_ACCESS_KEY_FILE=
EM_MINIO_SECRET_KEY_FILE=
EM_REDIS_HOST=127.0.0.1
EM_REDIS_PORT=6379
EM_REDIS_USERNAME=enterprise_mind_app
EM_REDIS_PASSWORD_FILE=
EM_REDIS_STREAM=enterprise-mind:processing
# RAG model details stay in config/providers.yaml; all are intentionally unset initially.
# Selected-model draft: config/providers.example.yaml; fill local secret files as described
# in README.md. PowerShell path mapping: config/model-secrets.example.ps1.
# EM_RAG_CONFIG=config/rag.yaml
# EM_PROVIDERS_CONFIG=config/providers.yaml
# EM_EMBEDDING_API_KEY_FILE=/run/secrets/embedding_api_key
# EM_RERANK_API_KEY_FILE=/run/secrets/rerank_api_key
# EM_OCR_API_KEY_FILE=/run/secrets/ocr_api_key
# EM_VISION_API_KEY_FILE=/run/secrets/vision_api_key
# EM_OCR_SECRET_ID_FILE=/run/secrets/ocr_secret_id
# EM_OCR_SECRET_KEY_FILE=/run/secrets/ocr_secret_key
# Explicit model-only HTTP(S) proxy; unrelated system proxy variables are ignored.
# EM_MODEL_PROXY_URL=http://127.0.0.1:6696
# Only the Worker and isolated converter receive this shared internal service token.
# EM_OFFICE_CONVERTER_TOKEN_FILE=/run/secrets/converter_token
# Agent models remain unset until explicitly configured in providers.yaml.
# EM_AGENT_CONFIG=config/agent.yaml
# EM_LLM_API_KEY_FILE=/run/secrets/llm_api_key
# Before enabling LLM, provision --checkpoint-password-file, then run checkpoint-init as migrator.
# EM_CHECKPOINT_POSTGRES_USER=enterprise_mind_checkpoint
# EM_CHECKPOINT_POSTGRES_PASSWORD_FILE=/run/secrets/checkpoint_password
